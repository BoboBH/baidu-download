# ===== 配置文件说明 =====
# 这是配置文件的示例模板
# 复制此文件为 .env 并根据实际环境修改配置
#
# ⚠️ 安全警告 ⚠️
# .env 文件包含敏感凭据（密码、密钥、访问令牌等）
# 绝对不要将 .env 文件提交到版本控制系统
# 确保 .env 已添加到 .gitignore 文件中
#
# 开发环境：使用绝对路径指向本地工具
# 生产环境：使用相对路径 ./BaiduPCS-Go.exe

# ===== 百度网盘配置 =====
# 生产环境示例 (使用相对路径，EXE版本):
BAIDUPCS_GO_PATH=./BaiduPCS-Go.exe
#
# 开发环境示例 (使用绝对路径):
# BAIDUPCS_GO_PATH=D:/tools/BaiduPCS-Go-v4.0.1-windows-x64/BaiduPCS-Go.exe

# 百度网盘Cookie文件路径 (用于存储百度网盘登录凭证)
BAIDU_COOKIES_PATH=./baidu-cookies.txt

# 临时文件目录 (使用短路径避免Windows路径长度限制)
TEMP_DIR=./temp

# ===== SFTP服务器配置 =====
SFTP_HOST=192.168.0.122
SFTP_PORT=22
SFTP_USERNAME=sftp01
SFTP_PASSWORD=your_secure_password_here
SFTP_REMOTE_PATH=/sftp01/upload

# ===== MySQL数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=baidu_download

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=./logs/transfer.log

# ===== 性能配置 =====
MAX_RETRIES=3
CONCURRENT_UPLOADS=1

# ===== 其他配置 =====
# Cookie文件路径 (备用配置，通常与BAIDU_COOKIES_PATH保持一致)
COOKIES_FILE_PATH=./baidu-cookies.txt

# ===== 飞书配置 (自动模式必需) =====
# ⚠️ 重要：请替换为您自己的飞书应用凭据，不要使用示例值
# 飞书应用凭证 (用于接收和处理飞书消息)
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
# 飞书群组ID (用于发送下载通知)
FEISHU_CHAT_ID=your_feishu_chat_id_here
# 飞书消息时间范围 (小时)，默认24小时内
FEISHU_HOURS_LIMIT=24

# ===== 钉钉配置 (自动模式可选) =====
# ⚠️ 重要：请替换为您自己的钉钉机器人Webhook地址
# 钉钉机器人Webhook地址 (用于发送下载通知)
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_dingtalk_token_here

# ===== 消息处理配置 (自动模式) =====
# 默认提取码 (4位数字，当飞书消息中未指定提取码时使用)
MESSAGE_DEFAULT_EXTRACTION_CODE=0409

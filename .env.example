# ===== 百度网盘配置 =====
BAIDUPCS_GO_PATH=D:/tools/BaiduPCS-Go-v4.0.1-windows-x64/BaiduPCS-Go.exe
BAIDU_COOKIES_PATH=./baidu-cookies.txt
TEMP_DIR=./temp

# ===== SFTP服务器配置 =====
SFTP_HOST=192.168.0.122
SFTP_PORT=22
SFTP_USERNAME=sftp01
SFTP_PASSWORD=123456
SFTP_REMOTE_PATH=/sftp01/upload

# ===== MySQL数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=test

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=./logs/transfer.log

# ===== 性能配置 =====
MAX_RETRIES=3
CONCURRENT_UPLOADS=1

COOKIES_FILE_PATH=./baidu-cookies.txt

# ===== 飞书配置 (自动模式必需) =====
# 飞书应用凭证 (用于接收和处理飞书消息)
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here
# 飞书群组ID (用于发送下载通知)
FEISHU_CHAT_ID=your_feishu_chat_id_here
# 飞书消息时间范围 (小时)，默认24小时内
FEISHU_HOURS_LIMIT=24

# ===== 钉钉配置 (自动模式可选) =====
# 钉钉应用凭证 (用于接收和处理钉钉消息)
DINGTALK_APP_KEY=your_dingtalk_app_key_here
DINGTALK_APP_SECRET=your_dingtalk_app_secret_here
DINGTALK_CHAT_ID=your_dingtalk_chat_id_here
# 钉钉机器人Webhook地址 (用于发送下载通知)
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_webhook_token_here

# ===== 微信公众号配置 =====
# 注意：此功能需要外部依赖 - wewe_rss 系统必须正常运行
# wewe_rss 是一个微信公众号RSS订阅系统，本系统通过其数据库获取文章信息
# 在启用此功能前，请确保 wewe_rss 服务已安装并运行

# 微信文章处理功能开关 (设为 true 启用，false 禁用)
WXCHAT_ENABLED=false

# wewe_rss数据库配置 (源数据库，用于获取微信公众号文章)
# 安全警告：数据库密码敏感信息，请勿将 .env 文件提交到版本控制系统
# 生产环境建议使用强密码，并限制数据库访问权限
WXCHAT_WEWE_DB_HOST=localhost
WXCHAT_WEWE_DB_PORT=3306
WXCHAT_WEWE_DB_USER=root
WXCHAT_WEWE_DB_PASSWORD=your_wewe_db_password_here
WXCHAT_WEWE_DB_NAME=wewe_rss

# 微信文章SFTP上传配置
# 微信PDF文件将上传到此目录下，按YYMM格式组织（如：/wxchat/2407/文章.pdf）
WXCHAT_SFTP_REMOTE_PATH=/wxchat

# 微信文章基础URL (通常无需修改)
WXCHAT_BASE_URL=https://mp.weixin.qq.com/s/

# PDF生成配置
WXCHAT_PDF_TIMEOUT=60          # 页面加载超时时间（秒） [范围: 10-300]
WXCHAT_IMAGE_WAIT_TIME=20       # 图片加载等待时间（秒） [范围: 5-120]

# 反限流配置（每篇文章处理完后随机暂停，实际延时在 [DELAY, DELAY_MAX] 区间内随机取值）
WXCHAT_DOWNLOAD_DELAY=5         # 随机延时的下限（秒）
WXCHAT_DOWNLOAD_DELAY_MAX=50    # 随机延时的上限（秒）

# 浏览器持久化档案（保存微信验证后的cookie；首次需人工跑 test/manual/wxchat/wxchat_verify_once.py 完成验证）
WXCHAT_BROWSER_PROFILE=./.wxchat_browser_profile

# 历史查询配置
WXCHAT_MAX_DAYS=30              # 最大查询天数 [范围: 1-365]

# ===== 微信文章外部SFTP配置 (可选) =====
# 外部用户SFTP服务器配置 - 用于额外上传PDF给外部用户
# 如果不需要外部用户访问，可以留空或注释掉这些配置

# 外部SFTP服务器连接信息
WXCHAT_EXTERNAL_SFTP_HOST=external_sftp.example.com
WXCHAT_EXTERNAL_SFTP_PORT=22
WXCHAT_EXTERNAL_SFTP_USERNAME=external_user
WXCHAT_EXTERNAL_SFTP_PASSWORD=external_password
WXCHAT_EXTERNAL_SFTP_FOLDER=/external/wechat

# 排除的公众号名称列表 (用逗号分隔，不需要上传到外部SFTP的公众号)
# 例如：公众号A,公众号B,测试账号
WXCHAT_EXTERNAL_EXCLUDE_ACCOUNTS=内部账号,测试账号,临时账号

# ===== 消息处理配置 (自动模式) =====
# 默认提取码 (4位数字，当飞书消息中未指定提取码时使用)
MESSAGE_DEFAULT_EXTRACTION_CODE=0409

# 消息重试配置
# 失败消息的最大重试次数，超过此次数后将永久排除
MESSAGE_MAX_RETRIES=10              # 默认: 10, [范围: 1-100]

# ===== 文件夹智能检测配置 =====
# 启用智能文件夹检测功能 (设为 true 启用，false 禁用)
# 启用后，系统会先转存到临时文件夹检测PDF内容，确认后再重命名到目标文件夹
# 禁用后，直接转存到目标文件夹（原有的行为）
ENABLE_FOLDER_DETECTION=true

# 文件夹检测超时时间（秒），默认300秒（5分钟）
FOLDER_DETECTION_TIMEOUT=300

# 临时文件夹前缀，用于检测过程（会自动清理）
TEMP_FOLDER_PREFIX=temp_detect_
